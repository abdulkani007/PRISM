# PRISM Backend Environment Configuration Example
# Copy this file to .env and configure your keys

ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Groq LPU Inference (Free tier available at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound-mini

# GitHub Personal Access Token (Increases rate limit from 60 to 5000 req/hour)
GITHUB_TOKEN=your_github_token_here

# YouTube Data API v3 Key (Used for talk and conference footprint verification)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Optional: Public Search Provider API (SerpApi, Google Custom Search, etc.)
SEARCH_API_KEY=your_search_api_key_here

# Optional: Reverse Image Search Provider API (SerpApi / Google Lens)
REVERSE_IMAGE_API_KEY=your_reverse_image_api_key_here
