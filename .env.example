# -----------------------------------------------------------------------------
# PRISM: ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# -----------------------------------------------------------------------------
# Note: Copy this file to backend/.env and replace placeholders with valid credentials.
# NEVER commit .env with production credentials to source control.

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Core AI Inference (Groq Cloud LPU)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# Source Intelligence APIs
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
YOUTUBE_API_KEY=AIzaSyYourYouTubeDataApiKeyHere

# Security & Investigation Controls
MAX_CANDIDATE_SEARCH_DEPTH=3
REQUEST_TIMEOUT_SECONDS=15
